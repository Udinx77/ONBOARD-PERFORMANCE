SET NOCOUNT ON;
SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED;

DECLARE @StartWITA DATETIME2(0) = '__START_WITA__';
DECLARE @EndWITA   DATETIME2(0) = '__END_WITA__';

DECLARE @StartUTC DATETIME2(0) = DATEADD(HOUR, -8, @StartWITA);
DECLARE @EndUTC   DATETIME2(0) = DATEADD(HOUR, -8, @EndWITA);

IF DATEDIFF(MINUTE, @StartUTC, @EndUTC) < 15
    SET @StartUTC = DATEADD(MINUTE, -15, @EndUTC);

;WITH AllMachines AS (
    SELECT
        mr.OID AS MACHINE_OID,
        UPPER(LTRIM(RTRIM(mr.NAME))) AS MACHINE_NAME
    FROM mshist_rep.dbo.V_MACHINE_REFERENCE mr
    WHERE mr.NAME IS NOT NULL
      AND LEFT(UPPER(LTRIM(RTRIM(mr.NAME))), 2) IN ('CB', 'HB', 'KB', 'CT', 'KT')
    GROUP BY mr.OID, UPPER(LTRIM(RTRIM(mr.NAME)))
),
FilteredEvents AS (
    SELECT
        UPPER(LTRIM(RTRIM(E.EVENTSOURCE))) AS MACHINE_NAME,
        E.CLASS_ID,
        E.EVENTSOURCE,
        E.TIMESTAMP_UTC,
        E.LOCATION_X,
        E.LOCATION_Y,
        E.LOCATION_Z,
        E.SATELLITES,
        E.NEW_STATE_DESCRIPTION,
        ROW_NUMBER() OVER (
            PARTITION BY UPPER(LTRIM(RTRIM(E.EVENTSOURCE)))
            ORDER BY E.TIMESTAMP_UTC DESC
        ) AS RN
    FROM mshist_rep.dbo.PRODUCTION_EVENT E WITH (NOLOCK)
    WHERE E.TIMESTAMP_UTC >= @StartUTC
      AND E.TIMESTAMP_UTC <= @EndUTC
      AND E.CLASS_ID = 'PositionReport'
      AND E.ENGLISH_DESCRIPTION IS NULL
      AND E.LOCATION_X IS NOT NULL
      AND E.LOCATION_Y IS NOT NULL
      AND LEFT(UPPER(LTRIM(RTRIM(E.EVENTSOURCE))), 2) IN ('CB', 'HB', 'KB', 'CT', 'KT')
)
SELECT
    M.MACHINE_OID,
    M.MACHINE_NAME AS TRUCK,
    G.CLASS_ID,
    G.EVENTSOURCE,
    DATEADD(HOUR, 8, G.TIMESTAMP_UTC) AS TIMESTAMP_WITA,
    G.LOCATION_X,
    G.LOCATION_Y,
    G.LOCATION_Z,
    G.SATELLITES,
    G.NEW_STATE_DESCRIPTION,
    CASE
        WHEN G.TIMESTAMP_UTC IS NULL THEN 'NO GPS DATA'
        ELSE 'GPS DATA AVAILABLE'
    END AS GPS_DATA_STATUS
FROM AllMachines M
LEFT JOIN FilteredEvents G
    ON G.MACHINE_NAME = M.MACHINE_NAME
   AND G.RN = 1
ORDER BY M.MACHINE_NAME ASC
OPTION (RECOMPILE);